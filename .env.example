# کاسپین نامبر — نمونه‌ی تنظیمات؛ این فایل را به .env کپی کنید
# cp .env.example .env

# کلید امضای توکن — حتماً عوضش کنید:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ENVIRONMENT=production

# حساب ادمینِ اولیه (فقط اولین اجرا ساخته می‌شود)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# نام و کد واحد مستقل دفتر مرکزی
HEAD_OFFICE_NAME=دفتر مرکزی
HEAD_OFFICE_CODE=HEAD

# فقط originهای دقیق و مجاز، جداشده با کاما
CORS_ORIGINS=https://phone.rasha-paper.com
ACCESS_TOKEN_EXPIRE_MINUTES=720
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_SECONDS=300

# پیش‌شماره‌ی شماره‌ی مستقیم
DIRECT_PREFIX=02144

# سرویس هوش مصنوعی (سازگار با OpenAI) — برای دکمه‌ی «تکمیل با هوش مصنوعی»
# در فرم پرسنل. اگر AI_API_KEY خالی بماند دکمه خطای روشن می‌دهد و بقیه‌ی
# برنامه مثل قبل کار می‌کند.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
